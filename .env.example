# Copy to .env and fill in. .env is gitignored — it holds the real secrets.

# Your DuckDNS hostname, e.g. mywiki.duckdns.org  (no https://, no trailing /)
WIKI_DOMAIN=CHANGEME.duckdns.org

# Database
DB_NAME=wikidb
DB_USER=wikiuser
DB_PASSWORD=CHANGEME
DB_ROOT_PASSWORD=CHANGEME

# MediaWiki secrets — generate with: openssl rand -hex 32
MW_SECRET_KEY=CHANGEME
MW_UPGRADE_KEY=CHANGEME
